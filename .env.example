# Canonical site URL used for metadata, OG images, sitemap and robots.
# Set this to your production domain, e.g. https://ai-hunt.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (public, safe to expose).
NEXT_PUBLIC_GA_ID=

# Newsletter (Buttondown) — powers the footer subscribe form.
# Create a free account at https://buttondown.com/ then paste your API key.
BUTTONDOWN_API_KEY=

# NVIDIA NIM API key (required for chatbot)
# Get one at https://build.nvidia.com/
NVIDIA_API_KEY=

# Fallback API key (optional)
# DAHL_API_KEY=
# Optional override for the primary NVIDIA NIM chat model
# NVIDIA_MODEL=

# GitHub token (optional, raises rate limit for live GitHub snapshots in /chat)
# GITHUB_TOKEN=

# Admin authentication (required for /api/auth/admin-login & /api/admin/*)
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upstash Redis REST API (distributed rate limiting, quotas, signup count, push subs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Visitor identity HMAC secret (falls back to AUTH_SECRET if unset)
VISITOR_HMAC_SECRET=

# Global & Per-Endpoint AI Cost Protection Defaults
AI_EMERGENCY_DISABLE=false
AI_GLOBAL_DAILY_REQUEST_LIMIT=500
AI_GLOBAL_MONTHLY_REQUEST_LIMIT=10000
AI_GLOBAL_MAX_CONCURRENT=10

CV_MONTHLY_LIMIT=3
CV_ABUSE_PER_MINUTE_LIMIT=10

CHAT_PER_MINUTE_LIMIT=5
CHAT_PER_HOUR_LIMIT=20
CHAT_PER_DAY_LIMIT=50
CHAT_PER_MONTH_LIMIT=300
CHAT_MAX_CONCURRENT=1

GOAL_PER_MINUTE_LIMIT=5
GOAL_PER_DAY_LIMIT=20
GOAL_PER_MONTH_LIMIT=100
GOAL_MAX_CONCURRENT=1
GOAL_CACHE_TTL_SECONDS=300

# Anti-Bot / Optional Cloudflare Turnstile
AI_BOT_STRICT=true
TURNSTILE_SECRET_KEY=

# Web Push VAPID keys (for browser notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Paid guides MVP — direct virement + WhatsApp (no PayPal)
# Your WhatsApp number, digits only with country code, e.g. 212612345678
WHATSAPP_NUMBER=
# Your RIB shown on /guides/[slug], e.g. "RIB 123-456-... (Banque — Name)"
PAYMENT_RIB=
