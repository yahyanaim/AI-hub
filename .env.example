# Canonical site URL used for metadata, OG images, sitemap and robots.
# Set this to your production domain, e.g. https://ai-hunt.com
NEXT_PUBLIC_SITE_URL=

# Newsletter (Buttondown) — powers the footer subscribe form.
# Create a free account at https://buttondown.com/ then paste your API key.
BUTTONDOWN_API_KEY=

# NVIDIA NIM API key (required for chatbot)
# Get one at https://build.nvidia.com/
NVIDIA_API_KEY=

# Fallback API key (optional)
# DAHL_API_KEY=

# Paid guides MVP — direct virement + WhatsApp (no PayPal)
# Your WhatsApp number, digits only with country code, e.g. 212612345678
WHATSAPP_NUMBER=
# Your RIB shown on /guides/[slug], e.g. "RIB 123-456-... (Banque — Name)"
PAYMENT_RIB=
